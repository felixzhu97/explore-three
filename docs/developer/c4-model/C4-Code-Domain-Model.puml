@startuml C4-Code-Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title Code diagram (C4) — Explore Three domain (src/domain/model only)
hide empty members

legend right
  |= Stereotype |= Meaning |
  | <<Entity>> | Identity + lifecycle |
  | <<ValueObject>> | Immutable by value |
endlegend

note as N_LAYERS
  components → infra/three → domain/model
  Three.js bootstrap (createGlobe, land, arcs)
  lives in src/infra/three — not on this diagram.
  Preferred Terms: docs/Glossary.md
end note

package "Geography" as pkg_geo {
  class GeoCoord <<ValueObject>> {
    +lat: number
    +lon: number
    --
    +projectToVector3(radius)
  }
}

package "Route" as pkg_route {
  class FlightRoute <<Entity>> {
    +origin: GeoCoord
    +destination: GeoCoord
  }
  class DEFAULT_ROUTES <<ValueObject>> {
    +routes: FlightRoute[]
  }
}

package "Theme" as pkg_theme {
  class ThemeType <<ValueObject>> {
    +bright
    +tech
  }
  class ThemeConfig <<ValueObject>> {
    +type: ThemeType
    +dotShader
    +lightConfig
    +buttonStroke: String
    +sourceUrl: String
  }
  class BRIGHT_THEME <<ValueObject>>
  class TECH_THEME <<ValueObject>>
  class BRIGHT_COLORS <<ValueObject>>
  class TECH_COLORS <<ValueObject>>
}

FlightRoute --> GeoCoord : origin
FlightRoute --> GeoCoord : destination
DEFAULT_ROUTES "1" *-- "0..*" FlightRoute
ThemeConfig --> ThemeType
BRIGHT_THEME --> ThemeConfig
TECH_THEME --> ThemeConfig

@enduml
