@startuml C4-Deployment
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
' 样式内联自 style.puml（勿改为 !include）
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Deployment] Explore Three - 本地与生产

Deployment_Node(dev_machine, "Developer Machine", "macOS / Linux") {
    Deployment_Node(vite_node, "Vite", "pnpm run dev") {
        Container(dev_spa, "Globe App (dev)", "React + Three.js", "HMR :5173")
    }
    Deployment_Node(local_assets, "Workspace", "filesystem") {
        ContainerDb(dev_img, "public/img", "static", "纹理同源")
    }
}

Deployment_Node(vercel_cloud, "Vercel", "Edge CDN") {
    Deployment_Node(prod_static, "Static Build", "vite build → dist") {
        Container(prod_spa, "Globe App (prod)", "SPA", "vercel.json rewrite /* → /index.html")
        ContainerDb(prod_img, "Bundled assets", "static", "img 随构建发布")
    }
}

Rel(dev_spa, dev_img, "加载纹理", "same-origin")
Rel(prod_spa, prod_img, "加载纹理", "same-origin")

SHOW_LEGEND()

@enduml
